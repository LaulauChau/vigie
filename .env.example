# Copy to .env (git-ignored) and fill in. Run commands with:
#   uv run --env-file .env vigie <command>

# Internal Ollama server, shared with OpenWebUI users.
OLLAMA_HOST=http://ollama.internal:11434

# Model used for Assessments and ranking. Defaults to qwen3.8.
LLM_MODEL=qwen3.8

# Slack Incoming Webhook the Digest is posted to. Secret: never commit it.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# SQLite database file. Defaults to vigie.db in the current folder.
DB_PATH=vigie.db
